  "panValueRule": {
    "candidatePattern": "(?<![\\p{L}\\p{N}])(?<![\\p{L}\\p{N}]-)[0-9](?:[ -]?[0-9]){12,18}(?![\\p{L}\\p{N}])(?!-[\\p{L}\\p{N}])",
    "digits": "13-19 after removing spaces and dashes; Luhn valid",
    "itemTextExemption": "ITEM_TEXT only: an unseparated 13 or 14 digit candidate with a valid GTIN check digit is a barcode",
    "strictFields": {
      "createPayment": [
        "merchantReference",
        "items[].taxGroupCode"
      ],
      "createReversal": [
        "merchantReference"
      ],
      "filters": [
        "merchantReference",
        "q"
      ]
    },
    "itemTextFields": {
      "createPayment": [
        "items[].name"
      ]
    }
  },
